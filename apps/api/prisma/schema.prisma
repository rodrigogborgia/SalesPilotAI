generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  SALES
  SUPPORT
  CLIENT_OPERATOR
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  EMAIL
  PHONE
  OTHER
}

enum TechnicalDocumentType {
  MANUAL
  SCHEMA
  DATASHEET
}

enum SupportTicketStatus {
  RECEIVED
  DIAGNOSING
  SCHEDULED
  REPAIRING
  RESOLVED
}

enum ConversationDirection {
  INBOUND
  OUTBOUND
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  brandName String?
  logoUrl   String?
  status    String   @default("active")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  categories         Category[]
  products           Product[]
  customers          Customer[]
  supportTickets     SupportTicket[]
  technicalDocuments TechnicalDocument[]
  installedEquipment InstalledEquipment[]
  maintenancePlans   MaintenancePlan[]
  conversations      Conversation[]
  copilotReferences  CopilotReference[]
  leads              Lead[]
  opportunities      Opportunity[]
  conversationAudits ConversationAudit[]
  promptHistory      PromptHistory[]

  @@index([status])
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String?
  email        String    @unique
  phone        String?
  role         UserRole  @default(SALES)
  status       String    @default("active")
  avatarUrl    String?
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads             Lead[]
  salesOpportunities        Opportunity[]       @relation("SalesOwner")
  assignedCopilotReferences CopilotReference[]
  authoredPromptHistory     PromptHistory[]
  conversationAudits        ConversationAudit[]

  @@index([organizationId, role])
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  sku         String
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  costPrice   Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installedEquipment InstalledEquipment[]
  technicalDocuments TechnicalDocument[]
  opportunities      Opportunity[]

  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fullName       String
  email          String?
  phone          String?
  companyName    String?
  documentNumber String?
  segment        String?
  address        String?
  notes          String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installedEquipment InstalledEquipment[]
  conversations      Conversation[]
  copilotReferences  CopilotReference[]
  opportunities      Opportunity[]

  @@index([organizationId, status])
}

model InstalledEquipment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  serialNumber     String    @unique
  qrToken          String    @unique @default(uuid())
  locationInPlant  String?
  model            String
  installationDate DateTime
  currentHours     Decimal   @default("0.00") @db.Decimal(10, 2)
  avgHoursPerDay   Decimal   @default("0.00") @db.Decimal(10, 2)
  warrantyEndDate  DateTime?
  status           String    @default("active")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  maintenancePlans MaintenancePlan[]
  supportTickets   SupportTicket[]

  @@index([organizationId, customerId])
}

model TechnicalDocument {
  id             String                @id @default(uuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String
  documentType   TechnicalDocumentType
  fileUrl        String
  createdAt      DateTime              @default(now())

  @@index([organizationId, productId])
  @@index([productId, documentType])
}

model SupportTicket {
  id                   String              @id @default(uuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installedEquipmentId String
  installedEquipment   InstalledEquipment  @relation(fields: [installedEquipmentId], references: [id], onDelete: Restrict)
  symptoms             String
  photos               String[]            @default([])
  status               SupportTicketStatus @default(RECEIVED)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, installedEquipmentId])
}

model MaintenancePlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  installedEquipmentId String
  installedEquipment   InstalledEquipment @relation(fields: [installedEquipmentId], references: [id], onDelete: Cascade)

  planName      String
  intervalHours Int
  nextDueHours  Int
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizationId, status])
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToUserId String?
  assignedToUser   User?   @relation(fields: [assignedToUserId], references: [id])

  source         String
  sourceCampaign String?
  customerName   String
  contactPhone   String?
  email          String?
  companyName    String?
  status         String   @default("new")
  score          Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunities Opportunity[]

  @@index([organizationId, status])
}

model Opportunity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  salesOwnerUserId String?
  salesOwnerUser   User?   @relation("SalesOwner", fields: [salesOwnerUserId], references: [id])

  stage             String    @default("new")
  amount            Decimal   @default("0.00") @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  probability       Int       @default(0)
  notes             String?
  wonAt             DateTime?
  lostAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, stage])
}

model Conversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  contactChannel     ChannelType           @default(WHATSAPP)
  channelRef         String?
  threadId           String?
  senderName         String?
  senderPhone        String?
  direction          ConversationDirection @default(INBOUND)
  content            String?
  summary            String?
  requiresDerivation Boolean               @default(false)
  status             String                @default("open")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  copilotReferences  CopilotReference[]
  conversationAudits ConversationAudit[]

  @@index([organizationId, status])
  @@index([organizationId, contactChannel])
}

model CopilotReference {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  refCode          String  @unique
  assignedToUserId String?
  assignedToUser   User?   @relation(fields: [assignedToUserId], references: [id])

  sourceChannel      ChannelType
  summary            String?
  resolved           Boolean     @default(false)
  resolvedAt         DateTime?
  requiresDerivation Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([organizationId, refCode])
  @@index([organizationId, resolved])
}

model ConversationAudit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  severity         AuditSeverity @default(MEDIUM)
  objectiveSummary String?
  sentiment        String?
  objections       String[]
  insights         Json?
  recommendations  Json?
  createdAt        DateTime      @default(now())

  @@index([organizationId, createdAt])
}

model PromptHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  title      String
  promptText String
  summary    String?
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([organizationId, createdAt])
}
