generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  brandName String?
  logoUrl   String?
  status    String   @default("active")
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  categories         Category[]
  products           Product[]
  customers          Customer[]
  supportTickets     SupportTicket[]
  technicalDocuments TechnicalDocument[]
  installedEquipment InstalledEquipment[]
  maintenancePlans   MaintenancePlan[]
  conversations      Conversation[]
  copilotReferences  CopilotReference[]
  leads              Lead[]
  manualFollowUps    ManualFollowUp[]
  opportunities      Opportunity[]
  conversationAudits ConversationAudit[]
  promptHistory      PromptHistory[]
  budgets            Budget[]
  budgetFollowUps    BudgetFollowUp[]
  budgetOrderExports BudgetOrderExport[]
  commercialLearningRules CommercialLearningRule[]
  voiceMinutes       VoiceMinute[]
  metaAudienceEntries MetaAudienceEntry[]
  completedSales     CompletedSale[]

  @@index([status])
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String?
  email        String    @unique
  phone        String?
  role         String    @default("SALES")
  status       String    @default("active")
  avatarUrl    String?
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads             Lead[]
  assignedManualFollowUps   ManualFollowUp[]
  salesOpportunities        Opportunity[]       @relation("SalesOwner")
  assignedCopilotReferences CopilotReference[]
  authoredPromptHistory     PromptHistory[]
  conversationAudits        ConversationAudit[]
  authoredVoiceMinutes      VoiceMinute[]
  capturedMetaAudiences      MetaAudienceEntry[]
  authoredLearningRules      CommercialLearningRule[]

  @@index([organizationId, role])
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  sku         String
  name        String
  description String?
  price       Decimal?
  costPrice   Decimal?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installedEquipment InstalledEquipment[]
  technicalDocuments TechnicalDocument[]
  opportunities      Opportunity[]

  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fullName       String
  contactTitle   String?
  email          String?
  corporateEmail String?
  phone          String?
  companyName    String?
  documentNumber String?
  segment        String?
  address        String?
  notes          String?
  status         String   @default("active")
  lastContactAt  DateTime?
  maintenanceWhatsAppSentAt    DateTime?
  maintenanceWhatsAppRepliedAt DateTime?
  requiresDirectCall           Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installedEquipment InstalledEquipment[]
  conversations      Conversation[]
  copilotReferences  CopilotReference[]
  opportunities      Opportunity[]
  budgets            Budget[]
  voiceMinutes       VoiceMinute[]
  metaAudienceEntries MetaAudienceEntry[]

  @@index([organizationId, status])
}

model InstalledEquipment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  serialNumber     String    @unique
  qrToken          String    @unique @default(uuid())
  locationInPlant  String?
  model            String
  installationDate DateTime
  currentHours     Decimal   @default("0.00")
  avgHoursPerDay   Decimal   @default("0.00")
  warrantyEndDate  DateTime?
  status           String    @default("active")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  maintenancePlans MaintenancePlan[]
  supportTickets   SupportTicket[]
  budgets          Budget[]
  voiceMinutes     VoiceMinute[]

  @@index([organizationId, customerId])
}

model TechnicalDocument {
  id             String                @id @default(uuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String
  documentType   String
  fileUrl        String
  createdAt      DateTime              @default(now())

  @@index([organizationId, productId])
  @@index([productId, documentType])
}

model SupportTicket {
  id                   String              @id @default(uuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installedEquipmentId String
  installedEquipment   InstalledEquipment  @relation(fields: [installedEquipmentId], references: [id], onDelete: Restrict)
  symptoms             String
  photos               Json
  status               String              @default("RECEIVED")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, installedEquipmentId])
}

model MaintenancePlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  installedEquipmentId String
  installedEquipment   InstalledEquipment @relation(fields: [installedEquipmentId], references: [id], onDelete: Cascade)

  planName      String
  intervalHours Int
  nextDueHours  Int
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizationId, status])
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToUserId String?
  assignedToUser   User?   @relation(fields: [assignedToUserId], references: [id])

  source         String
  sourceCampaign String?
  customerName   String
  contactTitle  String?
  contactPhone   String?
  email          String?
  companyName    String?
  status         String   @default("new")
  score          Int      @default(0)
  notes          String?
  productInterest String?
  estimatedAmount Decimal?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunities Opportunity[]
  manualFollowUps ManualFollowUp[]

  @@index([organizationId, status])
}

model ManualFollowUp {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedToUserId String?
  assignedToUser User?        @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  customer   String
  contactName String?
  contactTitle String?
  email      String?
  phone      String   @default("")
  reason     String
  dueAt      DateTime
  priority   String   @default("Media")
  owner      String
  status     String   @default("scheduled")
  result     String   @default("")
  completedAt DateTime?
  refCode    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([organizationId, owner, dueAt])
}

model Opportunity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  salesOwnerUserId String?
  salesOwnerUser   User?   @relation("SalesOwner", fields: [salesOwnerUserId], references: [id])

  stage             String    @default("new")
  amount            Decimal   @default("0.00")
  expectedCloseDate DateTime?
  probability       Int       @default(0)
  notes             String?
  wonAt             DateTime?
  lostAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, stage])
}

model Budget {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  installedEquipmentId String?
  installedEquipment   InstalledEquipment? @relation(fields: [installedEquipmentId], references: [id], onDelete: SetNull)

  status        String   @default("01 - Enviado")
  amount        Decimal  @default("0.00")
  motivoPerdida String?
  motivoPerdidaNota String?
  nextAction    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  voiceMinutes VoiceMinute[]
  followUps    BudgetFollowUp[]
  orderExports BudgetOrderExport[]

  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

model BudgetFollowUp {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgetId       String
  budget         Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  dayNumber      Int
  dueAt          DateTime
  status         String       @default("scheduled")
  message        String
  processedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@unique([budgetId, dayNumber])
  @@index([organizationId, status, dueAt])
}

model BudgetOrderExport {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgetId       String
  budget         Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  payload        Json
  exportedAt     DateTime     @default(now())

  @@index([organizationId, exportedAt])
  @@index([budgetId, exportedAt])
}

model CommercialLearningRule {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  refCode        String
  objection      String
  rule           String
  notificationStatus String @default("simulated")
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([refCode])
}

model VoiceMinute {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  installedEquipmentId String
  installedEquipment   InstalledEquipment @relation(fields: [installedEquipmentId], references: [id], onDelete: Cascade)

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  transcript   String?
  horometerHours Decimal
  nextAction   String?
  createdAt    DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([customerId, createdAt])
}

model MetaAudienceEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  capturedByUserId String?
  capturedByUser   User?   @relation(fields: [capturedByUserId], references: [id], onDelete: SetNull)

  email           String
  capturedByName  String
  tags            Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, createdAt])
}

model CompletedSale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email        String
  phone        String?
  company      String
  amount       Decimal
  purchaseDate DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, purchaseDate])
}

model Conversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  contactChannel     String                @default("WHATSAPP")
  channelRef         String?
  threadId           String?
  senderName         String?
  senderPhone        String?
  direction          String                @default("INBOUND")
  content            String?
  summary            String?
  requiresDerivation Boolean               @default(false)
  status             String                @default("open")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  copilotReferences  CopilotReference[]
  conversationAudits ConversationAudit[]

  @@index([organizationId, status])
  @@index([organizationId, contactChannel])
}

model CopilotReference {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  refCode          String  @unique
  assignedToUserId String?
  assignedToUser   User?   @relation(fields: [assignedToUserId], references: [id])

  sourceChannel      String
  summary            String?
  resolved           Boolean     @default(false)
  resolvedAt         DateTime?
  requiresDerivation Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([organizationId, refCode])
  @@index([organizationId, resolved])
}

model ConversationAudit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  severity         String        @default("MEDIUM")
  objectiveSummary String?
  sentiment        String?
  objections       Json
  insights         Json?
  recommendations  Json?
  createdAt        DateTime      @default(now())

  @@index([organizationId, createdAt])
}

model PromptHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  title      String
  promptText String
  summary    String?
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([organizationId, createdAt])
}
